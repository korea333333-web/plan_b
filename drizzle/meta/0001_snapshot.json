      "checkConstraints": {
        "plans_client_id_length_check": {
          "name": "plans_client_id_length_check",
          "value": "length(\"plans\".\"client_id\") between 8 and 128"
        },
        "plans_title_length_check": {
          "name": "plans_title_length_check",
          "value": "length(\"plans\".\"title\") between 1 and 120"
        },
        "plans_date_format_check": {
          "name": "plans_date_format_check",
          "value": "\"plans\".\"date\" glob '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'"
        },
        "plans_start_format_check": {
          "name": "plans_start_format_check",
          "value": "\"plans\".\"start\" glob '[0-2][0-9]:[0-5][0-9]'"
        },
        "plans_end_format_check": {
          "name": "plans_end_format_check",
          "value": "\"plans\".\"end\" glob '[0-2][0-9]:[0-5][0-9]'"
        },
        "plans_time_order_check": {
          "name": "plans_time_order_check",
          "value": "\"plans\".\"start\" < \"plans\".\"end\""
        },
        "plans_repeat_json_check": {
          "name": "plans_repeat_json_check",
          "value": "\"plans\".\"repeat\" is null or json_valid(\"plans\".\"repeat\")"
        },
        "plans_category_length_check": {
          "name": "plans_category_length_check",
          "value": "\"plans\".\"category\" is null or length(\"plans\".\"category\") <= 40"
        },
        "plans_memo_length_check": {
          "name": "plans_memo_length_check",
          "value": "length(\"plans\".\"memo\") <= 1000"
        },
        "plans_status_check": {
          "name": "plans_status_check",
          "value": "\"plans\".\"status\" in ('planned', 'completed', 'incomplete', 'unconfirmed')"
        },
        "plans_occurrence_statuses_json_check": {
          "name": "plans_occurrence_statuses_json_check",
          "value": "json_valid(\"plans\".\"occurrence_statuses\") and json_type(\"plans\".\"occurrence_statuses\") = 'object'"
        },
        "plans_source_check": {
          "name": "plans_source_check",
          "value": "\"plans\".\"source\" in ('manual', 'auto')"
